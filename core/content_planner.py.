
"""
FORTALEZA SHOP AI
Planificador automático de contenido.

Convierte productos registrados en planes de videos
promocionales. No publica ni realiza compras.
"""

import json
import logging
import re
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

import config

logger = logging.getLogger("FORTALEZA_SHOP_AI.content_planner")

TIMEZONE = ZoneInfo("America/Mexico_City")

PRODUCTS_DIR = Path(config.DATA_DIR) / "products"
PLANS_DIR = Path(config.OUTPUT_DIR) / "content_plans"


def safe_filename(value):
    """Genera nombres seguros para los archivos."""
    value = re.sub(r"[^\w\-]+", "_", str(value))
    return value.strip("_")[:70] or "contenido"


def initialize_directories():
    PRODUCTS_DIR.mkdir(parents=True, exist_ok=True)
    PLANS_DIR.mkdir(parents=True, exist_ok=True)


def load_products():
    """Carga todos los productos registrados."""
    initialize_directories()

    products = []

    for path in PRODUCTS_DIR.glob("*.json"):
        try:
            with path.open("r", encoding="utf-8") as file:
                product = json.load(file)

            if isinstance(product, dict):
                products.append(product)

        except (OSError, json.JSONDecodeError):
            logger.warning("No se pudo leer: %s", path)

    return products


def validate_product(product):
    """Comprueba los datos mínimos del producto."""
    problems = []

    if not product.get("id"):
        problems.append("Falta el identificador.")

    if not product.get("name"):
        problems.append("Falta el nombre.")

    affiliate_url = product.get("affiliate_url", "")

    if not affiliate_url.startswith("https://"):
        problems.append("Falta un enlace HTTPS de afiliado.")

    if not product.get("assets"):
        problems.append(
            "Falta incorporar material promocional autorizado."
        )

    return {
        "valid": len(problems) == 0,
        "problems": problems,
    }


def build_video_plan(product):
    """
    Construye un plan de video sin inventar características.

    Las escenas se basan en información comprobable
    y recursos promocionales disponibles.
    """

    validation = validate_product(product)

    name = product.get("name", "Producto")
    price = product.get("price_mxn")
    assets = product.get("assets", [])

    scenes = [
        {
            "number": 1,
            "purpose": "Gancho",
            "text": f"¿Ya conoces {name}?",
            "visual": "Mostrar una imagen autorizada del producto.",
        },
        {
            "number": 2,
            "purpose": "Presentación",
            "text": f"Te presentamos: {name}.",
            "visual": "Mostrar el producto de cerca.",
        },
        {
            "number": 3,
            "purpose": "Información",
            "text": (
                f"Consulta los detalles y características "
                f"directamente en la ficha del vendedor."
            ),
            "visual": "Mostrar imágenes autorizadas y detalles verificables.",
        },
        {
            "number": 4,
            "purpose": "Precio",
            "text": (
                f"Precio observado: ${price:.2f} MXN. "
                "Puede cambiar."
                if isinstance(price, (int, float))
                else "Consulta el precio actualizado en la tienda."
            ),
            "visual": "Mostrar el producto y su presentación.",
        },
        {
            "number": 5,
            "purpose": "Llamada a la acción",
            "text": "Consulta el producto en el enlace disponible.",
            "visual": "Mostrar el producto y dirigir a la ficha oficial.",
        },
    ]

    return {
        "product_id": product.get("id"),
        "product_name": name,
        "platform": product.get("platform"),
        "affiliate_url": product.get("affiliate_url"),
        "created_at": datetime.now(TIMEZONE).isoformat(),
        "video_format": "9:16",
        "target_duration_seconds": 30,
        "language": "es-MX",
        "show_face": False,
        "publication_status": "DRAFT",
        "validation": validation,
        "assets": assets,
        "scenes": scenes,
        "affiliate_disclosure": (
            "Este contenido incluye un enlace de afiliado. "
            "Si compras mediante él, podemos recibir una comisión."
        ),
        "publication_checklist": [
            "Verificar precio y disponibilidad actuales.",
            "Confirmar que las imágenes y videos estén autorizados.",
            "Comprobar que las afirmaciones sean verdaderas.",
            "Activar la divulgación de contenido comercial cuando corresponda.",
            "Verificar que el enlace de afiliado funcione.",
            "Revisar el video antes de publicarlo.",
        ],
        "ready_for_video": validation["valid"],
        "automatic_publication": False,
        "cost_mxn": 0,
    }


def save_plan(plan):
    """Guarda el plan de contenido."""
    initialize_directories()

    filename = safe_filename(
        plan.get("product_id", "producto")
    )

    destination = PLANS_DIR / f"{filename}_plan.json"

    with destination.open("w", encoding="utf-8") as file:
        json.dump(
            plan,
            file,
            ensure_ascii=False,
            indent=4,
        )

    return str(destination)


def create_product_plan(product_id):
    """Crea un plan para un producto específico."""
    products = load_products()

    product = next(
        (
            item for item in products
            if item.get("id") == product_id
        ),
        None,
    )

    if product is None:
        raise FileNotFoundError(
            f"No se encontró el producto: {product_id}"
        )

    plan = build_video_plan(product)
    plan_path = save_plan(plan)

    logger.info("Plan creado: %s", plan_path)

    return {
        "success": True,
        "plan_path": plan_path,
        "product_name": plan["product_name"],
        "ready_for_video": plan["ready_for_video"],
        "problems": plan["validation"]["problems"],
        "publication_status": "DRAFT",
    }


def create_all_product_plans():
    """Crea planes para todos los productos registrados."""
    results = []

    for product in load_products():
        product_id = product.get("id")

        if not product_id:
            continue

        try:
            results.append(
                create_product_plan(product_id)
            )
        except Exception as error:
            logger.exception(
                "Error creando plan para %s",
                product_id,
            )

            results.append({
                "success": False,
                "product_id": product_id,
                "error": str(error),
            })

    return results


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)

    results = create_all_product_plans()

    print(
        json.dumps(
            results,
            indent=4,
            ensure_ascii=False,
        )
    )
