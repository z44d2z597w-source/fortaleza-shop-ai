
"""
FORTALEZA SHOP AI
Sistema gratuito de estadísticas y rendimiento.

Registra visitas, ventas y comisiones.
Permite importar resultados manualmente.
No utiliza APIs de pago ni inventa estadísticas.
"""

import csv
import json
import logging
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

import config

logger = logging.getLogger("FORTALEZA_SHOP_AI.analytics")

TIMEZONE = ZoneInfo("America/Mexico_City")

ANALYTICS_DIR = Path(config.DATA_DIR) / "analytics"
EVENTS_FILE = ANALYTICS_DIR / "events.json"
REPORT_FILE = Path(config.OUTPUT_DIR) / "analytics_report.json"


def initialize_directories():
    ANALYTICS_DIR.mkdir(parents=True, exist_ok=True)
    REPORT_FILE.parent.mkdir(parents=True, exist_ok=True)

    if not EVENTS_FILE.exists():
        EVENTS_FILE.write_text("[]", encoding="utf-8")


def load_events():
    initialize_directories()

    try:
        with EVENTS_FILE.open("r", encoding="utf-8") as file:
            events = json.load(file)

        return events if isinstance(events, list) else []

    except (json.JSONDecodeError, OSError):
        logger.warning("No se pudieron leer los eventos.")
        return []


def save_events(events):
    initialize_directories()

    temporary = EVENTS_FILE.with_suffix(".tmp")

    with temporary.open("w", encoding="utf-8") as file:
        json.dump(
            events,
            file,
            ensure_ascii=False,
            indent=4,
        )

    temporary.replace(EVENTS_FILE)


def register_event(
    product_id,
    event_type,
    quantity=1,
    amount_mxn=0,
    source="manual",
):
    """
    Registra un evento.

    Tipos permitidos:
    click, sale, commission, video_published,
    video_view, refund.
    """

    allowed_events = {
        "click",
        "sale",
        "commission",
        "video_published",
        "video_view",
        "refund",
    }

    if event_type not in allowed_events:
        raise ValueError("Tipo de evento no permitido.")

    if not product_id:
        raise ValueError("Falta el identificador del producto.")

    if isinstance(quantity, bool) or not isinstance(quantity, int):
        raise ValueError("La cantidad debe ser un número entero.")

    if quantity <= 0:
        raise ValueError("La cantidad debe ser mayor que cero.")

    if isinstance(amount_mxn, bool) or not isinstance(
        amount_mxn, (int, float)
    ):
        raise ValueError("El importe debe ser numérico.")

    if amount_mxn < 0:
        raise ValueError("El importe no puede ser negativo.")

    event = {
        "product_id": str(product_id),
        "event_type": event_type,
        "quantity": quantity,
        "amount_mxn": round(float(amount_mxn), 2),
        "source": str(source),
        "timestamp": datetime.now(TIMEZONE).isoformat(),
        "verified": source == "tiktok_shop_export",
    }

    events = load_events()
    events.append(event)
    save_events(events)

    logger.info(
        "Evento registrado: %s - %s",
        product_id,
        event_type,
    )

    return event


def import_csv(csv_path):
    """
    Importa estadísticas desde un CSV.

    Columnas requeridas:
    product_id,event_type,quantity,amount_mxn

    La fuente del archivo debe ser un reporte legítimo
    de la plataforma o un registro propio.
    """

    path = Path(csv_path)

    if not path.exists():
        raise FileNotFoundError(
            f"No se encontró el archivo: {path}"
        )

    imported = 0
    errors = []

    with path.open(
        "r",
        encoding="utf-8-sig",
        newline="",
    ) as file:

        reader = csv.DictReader(file)

        required = {
            "product_id",
            "event_type",
            "quantity",
            "amount_mxn",
        }

        if not reader.fieldnames or not required.issubset(
            set(reader.fieldnames)
        ):
            raise ValueError(
                "El CSV debe contener: "
                "product_id,event_type,quantity,amount_mxn"
            )

        for row_number, row in enumerate(reader, start=2):
            try:
                register_event(
                    product_id=row["product_id"].strip(),
                    event_type=row["event_type"].strip(),
                    quantity=int(row["quantity"]),
                    amount_mxn=float(row["amount_mxn"]),
                    source="tiktok_shop_export",
                )

                imported += 1

            except (ValueError, TypeError, KeyError) as error:
                errors.append({
                    "row": row_number,
                    "error": str(error),
                })

    return {
        "imported": imported,
        "errors": errors,
    }


def calculate_product_metrics(events):
    """Calcula las estadísticas de cada producto."""

    products = {}

    for event in events:
        product_id = event.get("product_id")

        if not product_id:
            continue

        if product_id not in products:
            products[product_id] = {
                "product_id": product_id,
                "clicks": 0,
                "views": 0,
                "sales": 0,
                "refunds": 0,
                "videos_published": 0,
                "commissions_mxn": 0.0,
            }

        metrics = products[product_id]
        event_type = event.get("event_type")
        quantity = int(event.get("quantity", 0))
        amount = float(event.get("amount_mxn", 0))

        if event_type == "click":
            metrics["clicks"] += quantity

        elif event_type == "video_view":
            metrics["views"] += quantity

        elif event_type == "sale":
            metrics["sales"] += quantity

        elif event_type == "refund":
            metrics["refunds"] += quantity

        elif event_type == "video_published":
            metrics["videos_published"] += quantity

        elif event_type == "commission":
            metrics["commissions_mxn"] += amount

    for metrics in products.values():
        metrics["commissions_mxn"] = round(
            metrics["commissions_mxn"], 2
        )

        clicks = metrics["clicks"]

        metrics["click_to_sale_rate_percent"] = (
            round(metrics["sales"] / clicks * 100, 2)
            if clicks > 0
            else 0
        )

    return list(products.values())


def generate_report():
    """Genera un informe general de rendimiento."""

    events = load_events()
    products = calculate_product_metrics(events)

    total_clicks = sum(p["clicks"] for p in products)
    total_views = sum(p["views"] for p in products)
    total_sales = sum(p["sales"] for p in products)
    total_refunds = sum(p["refunds"] for p in products)

    total_commissions = round(
        sum(p["commissions_mxn"] for p in products),
        2,
    )

    report = {
        "generated_at": datetime.now(TIMEZONE).isoformat(),
        "currency": "MXN",
        "total_products": len(products),
        "total_clicks": total_clicks,
        "total_views": total_views,
        "total_sales": total_sales,
        "total_refunds": total_refunds,
        "estimated_commissions_mxn": total_commissions,
        "products": products,
        "data_note": (
            "Las cifras dependen de los eventos registrados. "
            "Solo los reportes oficiales importados se marcan "
            "como procedentes de una exportación de TikTok Shop."
        ),
        "cost_mxn": 0,
    }

    initialize_directories()

    with REPORT_FILE.open("w", encoding="utf-8") as file:
        json.dump(
            report,
            file,
            ensure_ascii=False,
            indent=4,
        )

    return report


def show_report():
    """Muestra un resumen legible."""

    report = generate_report()

    print("\n===== FORTALEZA SHOP AI =====")
    print("ESTADÍSTICAS DEL NEGOCIO")
    print("============================")

    print("Productos:", report["total_products"])
    print("Visualizaciones:", report["total_views"])
    print("Clics:", report["total_clicks"])
    print("Ventas:", report["total_sales"])
    print("Devoluciones:", report["total_refunds"])

    print(
        "Comisiones registradas: $",
        report["estimated_commissions_mxn"],
        "MXN",
    )

    if not report["products"]:
        print("\nTodavía no hay estadísticas registradas.")

    return report


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)

    show_report()
